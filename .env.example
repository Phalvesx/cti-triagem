# --- VirusTotal ---
# Sem chave => modo simulado automático (fixtures em app/fixtures)
VT_API_KEY=
VT_MOCK=false

# --- MalwareBazaar (abuse.ch) ---  Auth-Key grátis em https://auth.abuse.ch/
MB_API_KEY=
MB_MOCK=false

# --- LLM (LangChain) ---
# openai | anthropic | none  (none = só heurística, não precisa de chave)
LLM_PROVIDER=none
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_TEMPERATURE=0

# --- Identidade visual (frontend + relatório HTML/PDF) ---
# Coloque o logo em app/static/logo.svg ou logo.png, ou aponte o caminho abaixo
BRAND_NAME=CTI · Threat Intelligence
BRAND_LOGO_PATH=app/static/logo.png
REPORT_TLP=TLP:AMBER

# --- Cache / limites ---
CACHE_TTL_HOURS=24
VT_MAX_RETRIES=2
VT_RETRY_BACKOFF=16

# --- Segurança ---
# API_TOKEN=troque-por-um-valor-longo   # se definido, a API exige o header X-API-Key
RATE_LIMIT_PER_MIN=30
MAX_BODY_KB=2048

# --- App ---
# Padrão: data/cti.db dentro da pasta do projeto (no Docker o compose usa /data/cti.db)
# DB_PATH=
LOG_LEVEL=INFO
